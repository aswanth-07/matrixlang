# Build products. Everything here is regenerated by `make`.
build/
bin/

# Editor and OS noise.
*.o
*.exe
.vscode/
.idea/
Thumbs.db

# Word owner-lock files, created while a .docx deliverable is open
~$*

# Python bytecode from the generators in tools/
__pycache__/
*.pyc

# Public paper source and exported PDFs are tracked. Local annotated drafting
# copies stay outside the build inputs; `make paper` uses matrixlang.tex.
paper/main.tex
tools/strip_anchors.py

# LaTeX build products. The PDF is committed; the intermediates are not.
paper/*.aux
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/build.log
paper/build-*.txt
