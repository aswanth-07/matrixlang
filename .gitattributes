# Pin text bytes for source and raw-data SHA-256 reproducibility on checkout.
* text=auto eol=lf

# Shell scripts also require LF at their shebang.
*.sh     text eol=lf
*.ml     text eol=lf
*.l      text eol=lf
*.y      text eol=lf
*.c      text eol=lf
*.h      text eol=lf
*.py     text eol=lf
*.js     text eol=lf
Makefile text eol=lf

# MatrixLang programs use .ml, which is also OCaml's extension. Without this,
# GitHub reports the repository as majority OCaml and editors apply OCaml
# highlighting to programs that are not OCaml. These are sample programs for
# the language this repository implements, not library code.
*.ml linguist-language=Text
*.ml linguist-documentation

# Binary deliverables: never diff or line-ending-convert these.
*.docx binary
*.pptx binary
*.png  binary
*.pdf  binary
